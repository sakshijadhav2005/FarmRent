# ===========================================
# FarmLink Project - Git Ignore File
# ===========================================

# ----- Dependencies -----
node_modules/
*/node_modules/

# ----- Environment Variables -----
.env
.env.local
.env.development
.env.production
*.env

# ----- Build Outputs -----
dist/
build/
.vite/

# ----- Logs -----
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
debug*.log

# ----- OS Generated Files -----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ----- IDE / Editor -----
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project
.project
.settings/
*.code-workspace

# ----- Testing -----
coverage/
.nyc_output/
test-results/
*.test.js
*.spec.js

# ----- Debug Files -----
diagnose.js
test*.js
debug*.js
debug*.log

# ----- Temporary Files -----
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup

# ----- Uploads (optional - uncomment if you don't want to track uploads) -----
# server/uploads/*
# !server/uploads/.gitkeep

# ----- Package Lock Files (optional - some prefer to track these) -----
# package-lock.json
# yarn.lock

# ----- Misc -----
*.pem
*.key
*.cert
.cache/
.parcel-cache/

# ----- Stripe/Payment Keys -----
# Never commit payment credentials
stripe-*.json

# ----- MongoDB -----
data/
*.mongodb

# ----- Python (if any scripts) -----
__pycache__/
*.py[cod]
*$py.class
.Python
*.so
venv/
ENV/
